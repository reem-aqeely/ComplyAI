# Google Gemini API key used for AI compliance analysis.
# Get a key from https://aistudio.google.com/apikey
# Never commit your real .env file.
#
# Read in the browser via import.meta.env.GEMINI_API_KEY, so it IS bundled into
# the client and readable by anyone who loads the app. Restart the dev server
# after changing it (Vite reads .env only at startup).
#
# Paste the key BARE — no quotes, no trailing spaces:
#   correct:   GEMINI_API_KEY=AIzaSy...
#   wrong:     GEMINI_API_KEY=AIzaSy..."     <- stray quote becomes part of the
#                                               key and Google returns 400
#                                               API_KEY_INVALID
GEMINI_API_KEY=
